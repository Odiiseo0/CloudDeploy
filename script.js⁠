const toolData = {
    docker: {
        title: "Docker",
        description: "Plataforma de contenedores que aísla aplicaciones y dependencias para garantizar ejecución idéntica en cualquier equipo o servidor."
    },
    aws: {
        title: "Amazon Web Services (AWS)",
        description: "Nube líder de Amazon. Utiliza servicios como ECS y EKS para administrar contenedores automatizados a gran escala."
    },
    azure: {
        title: "Microsoft Azure",
        description: "Nube de Microsoft con soporte para Azure Kubernetes (AKS) e integración nativa con herramientas de desarrollo."
    },
    gcp: {
        title: "Google Cloud Platform (GCP)",
        description: "Infraestructura de Google destacada por GKE (Google Kubernetes Engine) y Cloud Run para contenedores optimizados."
    }
};

function showInfo(toolKey) {
    const titleElement = document.getElementById("info-title");
    const textElement = document.getElementById("info-text");
    const infoBox = document.getElementById("info-box");

    if (toolData[toolKey]) {
        titleElement.textContent = toolData[toolKey].title;
        textElement.textContent = toolData[toolKey].description;
        
        infoBox.style.opacity = "0.2";
        setTimeout(() => {
            infoBox.style.opacity = "1";
        }, 100);
    }
}
