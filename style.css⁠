:root {
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --accent-color: #38bdf8;
    --text-color: #f1f5f9;
    --text-muted: #94a3b8;
    --border-color: #334155;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
}

header {
    background-color: rgba(30, 41, 59, 0.9);
    backdrop-filter: blur(10px);
    position: fixed;
    top: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    border-bottom: 1px solid var(--border-color);
    z-index: 1000;
}

.logo {
    font-weight: bold;
    font-size: 1.2rem;
    color: var(--accent-color);
    display: flex;
    align-items: center;
    gap: 8px;
}

nav a {
    color: var(--text-muted);
    text-decoration: none;
    margin-left: 20px;
    font-size: 0.9rem;
    transition: color 0.3s;
}

nav a:hover {
    color: var(--accent-color);
}

.container {
    max-width: 1000px;
    margin: 100px auto 40px;
    padding: 20px;
}

.card-section {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
}

.card-section h2 {
    color: var(--accent-color);
    margin-bottom: 15px;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.card-section > p {
    color: var(--text-muted);
    margin-bottom: 20px;
}

.image-box img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 20px;
}

.instruction {
    font-size: 0.9rem;
    color: var(--accent-color);
    margin-bottom: 12px;
}

.interactive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 15px;
    margin-bottom: 20px;
}

.tool-card {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    padding: 20px 10px;
    text-align: center;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.tool-card:hover {
    border-color: var(--accent-color);
    transform: translateY(-3px);
    background-color: #172033;
}

.tool-card i {
    font-size: 2rem;
    color: var(--accent-color);
    margin-bottom: 8px;
    display: block;
}

.tool-card span {
    font-size: 0.85rem;
    color: var(--text-color);
    font-weight: 500;
}

.info-display {
    background-color: var(--bg-color);
    border-left: 4px solid var(--accent-color);
    padding: 20px;
    border-radius: 0 8px 8px 0;
    transition: all 0.3s ease;
}

.info-display h4 {
    color: var(--accent-color);
    margin-bottom: 8px;
    font-size: 1.1rem;
}

.info-display p {
    color: var(--text-muted);
    font-size: 0.95rem;
}

.infra-list, .tests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
}

.infra-item, .test-card {
    background-color: var(--bg-color);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
}

.infra-item h4, .test-card h3 {
    color: var(--accent-color);
    font-size: 1.1rem;
    margin-bottom: 8px;
}

.infra-item p, .test-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.release-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.release-col {
    background-color: var(--bg-color);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
}

.release-col h3 {
    color: var(--accent-color);
    font-size: 1.1rem;
    margin-bottom: 12px;
}

.release-col ul {
    list-style-type: disc;
    padding-left: 20px;
    color: var(--text-muted);
    font-size: 0.9rem;
}

.release-col li {
    margin-bottom: 6px;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: var(--card-bg);
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.85rem;
}
